server {
    listen 80;
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        # Essential for Single Page Applications (SPA) like React/Vite
        # Redirects all routing requests back to index.html for react-router resolution
        try_files $uri $uri/ /index.html;
    }

    # Enable Gzip Compression for static assets
    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript;
    gzip_disable "MSIE [1-6]\.";

    # Cache static assets (JS, CSS, images) aggressively to reduce bandwidth usage
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|otf|svg|ttf)$ {
        root /usr/share/nginx/html;
        expires 30d;
        add_header Pragma public;
        add_header Cache-Control "public, must-revalidate, proxy-revalidate";
    }

    # Error pages configuration
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
