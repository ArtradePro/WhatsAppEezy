# --- Stage 1: Build Environment ---
FROM node:20-alpine AS build

WORKDIR /app

# Copy package configurations first to leverage layer caching
COPY package*.json ./

# Install both dependencies and devDependencies (needed to run build engines like Vite/CRA)
RUN npm ci

# Copy frontend source files
COPY . .

# Run the build compiler (Vite compiles output to /dist, CRA compiles to /build)
RUN npm run build

# --- Stage 2: Production Staging ---
FROM nginx:1.25-alpine AS runtime

# Copy custom Nginx configuration to support SPA routing fallbacks
COPY nginx.conf.frontend /etc/nginx/conf.d/default.conf

# Copy static assets generated from build stage
# Update '/app/dist' to '/app/build' if utilizing Create React App (CRA) instead of Vite
COPY --from=build /app/dist /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Start Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]
