# ========================================================
# WhatsApp Commerce Aggregator & Settlement Engine Configuration
# ========================================================

# Application Server
PORT=3000
NODE_ENV=production

# Database & Redis Queue (Railway / Supabase / PostgreSQL + PostGIS)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cargodash
REDIS_URL=redis://localhost:6379

# Meta Cloud API Webhook Handshake & Cryptographic Security
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_ACCESS_TOKEN=EAAG...your_meta_system_user_access_token
META_WEBHOOK_VERIFY_TOKEN=cargodash-secure-webhook-token
META_APP_SECRET=your_meta_app_secret_for_hmac_sha256

# Meta Commerce Manager / WhatsApp Catalog (Graph API v19.0)
META_GRAPH_API_VERSION=v19.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_CATALOG_ID=your_meta_commerce_catalog_id
META_ACCESS_TOKEN=EAAG...your_meta_system_user_access_token

# Cloudinary API (Sharp 1024x1024 Product Canvas & CDN Hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=whatsapp-commerce-catalog

# AI Vision & Runtime Extraction (Antigravity Gemini Flash — OpenAI Cross-Build Bridge OFF)
VISION_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
AI_CROSS_BUILD_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AUTO_MIGRATE_ON_STARTUP=true

# Google Distance Matrix & PostGIS Haulage Routing
GOOGLE_MAPS_API_KEY=your_google_maps_distance_matrix_api_key
VENDOR_DEFAULT_LAT=-34.2056
VENDOR_DEFAULT_LNG=21.5800
VENDOR_DEFAULT_WHATSAPP_NUMBER=27820000001

# PayFast Split-Checkout & ITN Verification (ZAR)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=payfast_secure_passphrase
PAYFAST_ENV=sandbox
PAYFAST_RETURN_URL=https://cargodash.com/checkout/success
PAYFAST_CANCEL_URL=https://cargodash.com/checkout/cancelled
PAYFAST_NOTIFY_URL=https://api.cargodash.com/api/webhooks/payfast/itn
PLATFORM_COMMISSION_PERCENTAGE=8.0

# Dedicated Xero Accounting Engine (OAuth2 & Batch Payments)
XERO_CLIENT_ID=your_xero_oauth2_client_id
XERO_CLIENT_SECRET=your_xero_oauth2_client_secret
XERO_TENANT_ID=your_xero_organization_tenant_id
XERO_BANK_ACCOUNT_ID=your_xero_settlement_bank_account_id

# Platform & Storefront Defaults
DEFAULT_BRAND_NAME=CargoDash Pro
DEFAULT_CURRENCY=ZAR
DEFAULT_COMMERCE_BASE_URL=https://wa.me/c/product

# Operational Mock Mode (Set to false in live production)
MOCK_EXTERNAL_APIS=false
